# ============================================
# KAYAKA-AI Environment Variables
# ============================================

# -------------------------------------------
# Supabase Configuration (REQUIRED)
# Get from: https://app.supabase.com/project/_/settings/api
# -------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️ IMPORTANT: NEVER commit VITE_SUPABASE_SERVICE_ROLE_KEY to git!
# This key bypasses Row Level Security - keep it secret!
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------
# Legacy OAuth (Not needed with Supabase)
# Keep these empty or remove - Supabase handles OAuth
# -------------------------------------------
# VITE_GOOGLE_CLIENT_ID=
# VITE_GITHUB_CLIENT_ID=
# VITE_GITHUB_CLIENT_SECRET=

# -------------------------------------------
# Backend API URL (Optional - for future)
# -------------------------------------------
VITE_API_URL=http://localhost:3000/api
