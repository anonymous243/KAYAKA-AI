# ============================================
# KAYAKA-AI Production Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# -------------------------------------------
# Supabase Configuration (REQUIRED)
# Get from: https://app.supabase.com/project/_/settings/api
# -------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️ IMPORTANT: NEVER commit VITE_SUPABASE_SERVICE_ROLE_KEY to git!
# This key bypasses Row Level Security - keep it secret!
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------
# Backend API URL (for production deployment)
# -------------------------------------------
VITE_API_URL=https://your-backend-url.com/api

# -------------------------------------------
# Razorpay Payment Gateway (Optional)
# Get from: https://dashboard.razorpay.com/
# -------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_your-key-id

# -------------------------------------------
# LinkedIn OAuth (Optional - for job targeting)
# -------------------------------------------
# VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# -------------------------------------------
# Google OAuth (Optional - configured via Supabase)
# Configure in Supabase Dashboard > Authentication > Providers
# -------------------------------------------
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
